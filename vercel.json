{
  "version": 2,
  "routes": [
    { "src": "/api/compute", "dest": "/api/compute.py" },
    { "src": "/api/save",    "dest": "/api/save.py"    },
    { "src": "/api/history", "dest": "/api/history.py" },
    { "src": "/css/(.*)",    "dest": "/public/css/$1"  },
    { "src": "/js/(.*)",     "dest": "/public/js/$1"   },
    { "src": "/",            "dest": "/public/index.html" },
    { "src": "/(.*)",        "dest": "/public/index.html" }
  ]
}
